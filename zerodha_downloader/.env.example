# Zerodha Kite Connect API Credentials
# Get these from your Zerodha Developer Console: https://developers.kite.trade/apps
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Download Settings
DEFAULT_INTERVAL=minute
DEFAULT_MONTHS=12
DATA_DIR=data
DEFAULT_FORMAT=parquet

# Optional Automated TOTP Login (leave blank if you prefer logging in via browser)
# KITE_USER_ID=
# KITE_PASSWORD=
# KITE_TOTP_KEY=
