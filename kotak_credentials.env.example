# ==============================================================================
# KOTAK NEO API CREDENTIALS CONFIGURATION
# ==============================================================================
# Copy this file to `kotak_credentials.env` and fill in your details.
# DO NOT commit `kotak_credentials.env` to version control.

# 1. Developer Portal Credentials (https://neo.kotaksecurities.com)
# Obtain these by creating an application in the Kotak Neo Trade API portal.
KOTAK_CONSUMER_KEY=your_consumer_key_here
KOTAK_CONSUMER_SECRET=your_consumer_secret_here

# 2. Kotak Neo Account Login Details
# Registered mobile number with country code (e.g. +919876543210)
KOTAK_MOBILE_NUMBER=+919876543210

# Unique Client Code (UCC) from your Kotak Neo app profile (e.g. ABCD12)
KOTAK_UCC=your_ucc_code_here

# 6-digit MPIN used to unlock Kotak Neo
KOTAK_MPIN=123456

# 3. Two-Factor Authentication (TOTP)
# The base32 secret key shown when setting up Google Authenticator / Authy.
# If provided, the script generates TOTP codes automatically without prompting.
# If left blank, the script will prompt you interactively in the terminal.
KOTAK_TOTP_KEY=

# 4. Storage Directory Configuration
# Path to your existing 1-minute Parquet files to stitch into
DATA_DIR=C:\Zerodha Historical Data\data\minute
